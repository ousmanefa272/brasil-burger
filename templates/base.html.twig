<!-- templates/base.html.twig -->
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Brasil Burger{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body>
<div class="d-flex">
    <!-- Sidebar -->
    <nav class="flex-column bg-dark text-white p-3" style="width: 220px; min-height: 100vh;">
        <h4>Administration</h4>
        <ul class="nav flex-column mt-3">
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('burger_index') }}">🍔 Burgers</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('menu_index') }}">📋 Menus</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('client_index') }}">👤 Clients</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('commande_index') }}">📦 Commandes</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('paiement_index') }}">💳 Paiements</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('complement_index') }}">➕ Compléments</a>
            </li>
        </ul>
    </nav>

    <!-- Main content -->
    <main class="flex-grow-1 p-3">
        {% block body %}{% endblock %}
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
