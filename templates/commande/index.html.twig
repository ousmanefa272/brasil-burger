{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block body %}
<div class="container my-5">

    <!-- Titre + bouton Ajouter -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">📦 Commandes</h1>
            <p class="text-muted mb-0">Liste des commandes clients</p>
        </div>

        <a href="{{ path('commande_new') }}" class="btn btn-dark">
            ➕ Ajouter une commande
        </a>
    </div>

    <!-- Liste des commandes -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Menu</th>
                        <th>Prix</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for commande in commandes %}
                        <tr>
                            <td>{{ commande.id }}</td>
                            <td>{{ commande.menu.nom }}</td>
                            <td>{{ commande.menu.prix }} XOF</td>
                            <td>
                                {% if commande.date %}
                                    {{ commande.date|date('d/m/Y H:i') }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Aucune commande pour le moment
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>

</div>
{% endblock %}
