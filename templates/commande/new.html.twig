{% extends 'base.html.twig' %}

{% block title %}Nouvelle commande{% endblock %}

{% block body %}
<div class="container my-5">

    <!-- Titre -->
    <div class="mb-4">
        <h1 class="fw-bold">➕ Nouvelle commande</h1>
        <p class="text-muted mb-0">Remplissez le formulaire pour ajouter une commande</p>
    </div>

    <!-- Formulaire -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.menu, 'Menu') }}
                {{ form_widget(form.menu, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.menu) }}
            </div>

            {# Si tu veux ajouter d'autres champs, par exemple quantité ou complément, tu peux les mettre ici #}

            <button type="submit" class="btn btn-dark">Ajouter la commande</button>

            {{ form_end(form) }}

        </div>
    </div>

    <!-- Lien retour à la liste -->
    <div class="mt-3">
        <a href="{{ path('commande_index') }}" class="btn btn-outline-secondary">← Retour à la liste des commandes</a>
    </div>

</div>
{% endblock %}
