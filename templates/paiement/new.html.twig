{% extends 'base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block body %}
<h1 class="mb-4">Effectuer un Paiement</h1>

<div class="card shadow p-4">
    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.montant) }}
            {{ form_widget(form.montant, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.mode) }}
            {{ form_widget(form.mode, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.date) }}
            {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
        </div>

        <button class="btn btn-success">Payer</button>
        <a href="{{ path('paiement_index') }}" class="btn btn-secondary">Retour</a>
    {{ form_end(form) }}
</div>
{% endblock %}
