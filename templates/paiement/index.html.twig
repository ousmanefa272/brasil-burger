{% extends 'base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block body %}
<div class="container my-5">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h2 class="text-center fw-bold mb-4">
                        💳 Paiement
                    </h2>

                    <!-- Récap commande -->
                    <div class="mb-4">
                        <h5 class="fw-bold mb-3">🧾 Récapitulatif</h5>

                        <div class="d-flex justify-content-between">
                            <span>Burger Classic</span>
                            <span>2 500 XOF</span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span>Burger Cheese</span>
                            <span>3 000 XOF</span>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span class="text-success">5 500 XOF</span>
                        </div>
                    </div>

                    <!-- Méthode de paiement -->
                    <div class="mb-4">
                        <h5 class="fw-bold mb-3">💰 Méthode de paiement</h5>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="payment" checked>
                            <label class="form-check-label">
                                Paiement à la livraison
                            </label>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="payment">
                            <label class="form-check-label">
                                Orange Money
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="payment">
                            <label class="form-check-label">
                                Wave
                            </label>
                        </div>
                    </div>

                    <!-- Bouton -->
                    <div class="d-grid">
                        <button class="btn btn-success btn-lg">
                            Confirmer le paiement
                        </button>
                    </div>

                    <p class="text-muted text-center mt-3 small">
                        🔒 Paiement sécurisé
                    </p>

                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}
