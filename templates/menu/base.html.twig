<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Brasil Burger{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Bootstrap #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-light">

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_menu_index') }}">
            🍔 Brasil Burger
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_menu_index') }}">Menus</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_menu_new') }}">Ajouter un menu</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- CONTENU -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- FOOTER -->
<footer class="bg-dark text-light text-center py-3 mt-5">
    <small>
        © {{ "now"|date("Y") }} Brasil Burger • Tous droits réservés
    </small>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
