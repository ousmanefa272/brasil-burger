{% extends 'base.html.twig' %}

{% block title %}Menu{% endblock %}

{% block body %}
    <h1 class="mb-4 text-center text-danger fw-bold">Notre Menu</h1>

    <div class="row">
        {% for menu in menus %}
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">{{ menu.nom }}</h5>
                        <p class="card-text text-muted fs-5">
                            <strong>{{ menu.prix }} XOF</strong>
                        </p>
                        <a href="#" class="btn btn-primary btn-sm">Commander</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-center text-muted">Aucun plat disponible pour le moment.</p>
        {% endfor %}
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('menu_new') }}" class="btn btn-success">➕ Ajouter un plat</a>
    </div>
{% endblock %}
