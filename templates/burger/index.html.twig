{% extends 'base.html.twig' %}

{% block title %}Liste des Burgers{% endblock %}

{% block body %}
<h1 class="mb-4">Burgers</h1>

<a href="{{ path('burger_new') }}" class="btn btn-primary mb-3">+ Nouveau Burger</a>

<table class="table table-striped table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prix</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for burger in burgers %}
        <tr>
            <td>{{ burger.id }}</td>
            <td>{{ burger.nom }}</td>
            <td>{{ burger.prix }} €</td>
            <td>
                <a href="{{ path('burger_edit', {'id': burger.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="4" class="text-center">Aucun burger</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
