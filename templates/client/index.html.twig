{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}

{% block body %}
<h1 class="mb-4">Clients</h1>

<a href="{{ path('client_new') }}" class="btn btn-primary mb-3">+ Nouveau Client</a>

<table class="table table-bordered shadow">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Téléphone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for client in clients %}
        <tr>
            <td>{{ client.id }}</td>
            <td>{{ client.nom }}</td>
            <td>{{ client.telephone }}</td>
            
        </tr>
    {% else %}
        <tr>
            <td colspan="5" class="text-center">Aucun client</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
