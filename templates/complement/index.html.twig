{% extends 'base.html.twig' %}

{% block title %}Compléments{% endblock %}

{% block body %}
<h1 class="mb-4">Compléments</h1>

<a href="{{ path('complement_new') }}" class="btn btn-primary mb-3">+ Nouveau Complément</a>

<table class="table table-striped shadow">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prix</th>
        </tr>
    </thead>
    <tbody>
    {% for complement in complements %}
        <tr>
            <td>{{ complement.id }}</td>
            <td>{{ complement.nom }}</td>
            <td>{{ complement.prix }} €</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="3" class="text-center">Aucun complément</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}

